# Public Supabase client values for the Vite browser app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Vercel/Supabase integrations may also provide these public names.
# GearVision supports them too:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Stripe Checkout values for Vercel API functions.
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=https://court-vision-nakul-r2025.vercel.app

# Optional server-only Supabase mirror for Stripe support payments.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
