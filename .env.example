VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Vercel/Supabase integrations may also provide these public names.
# GearVision supports them too:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key

# Stripe project support payments. These are server-only Vercel env vars.
# Never expose STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, or SUPABASE_SERVICE_ROLE_KEY in client code.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SITE_URL=https://www.gearvision.dev

# Optional: lets the Stripe webhook mirror completed support payments into Supabase.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
